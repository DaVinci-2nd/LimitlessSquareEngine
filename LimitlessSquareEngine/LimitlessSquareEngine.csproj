<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>LimitlessSquareEngine.Program</StartupObject>
  </PropertyGroup>

	<PropertyGroup>
		<AssemblyName>Limitless Square Engine</AssemblyName>
		<ApplicationIcon>Resources\LimitlessSquareEngineIcon.ico</ApplicationIcon>
	</PropertyGroup>
	
	<ItemGroup>
      <None Include="Engine\BuiltinShaders\**\*.vert">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>Assets\Shaders\Builtin\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      </None>

      <None Include="Engine\BuiltinShaders\**\*.frag">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>Assets\Shaders\Builtin\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      </None>
    </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AssimpNet" Version="4.1.0" />
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageReference Include="Jitter2.Double" Version="2.8.2" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="Prowl.Paper" Version="0.8.5" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>


  <ItemGroup>
    <Compile Remove="Editor\**\*.cs" />
    <EditorCompile Include="Editor\**\*.cs" />
  </ItemGroup>


  <ItemGroup>
    <Compile Include="Editor\Debug.cs" />
  </ItemGroup>

  <Target Name="BuildEditorDll" AfterTargets="Build" Condition="'@(EditorCompile)' != ''">
    <PropertyGroup>
      <EditorOutputPath>$(OutDir)Limitless Square Editor.dll</EditorOutputPath>
    </PropertyGroup>

    <ItemGroup>
      <EditorReference Include="@(ReferencePath)" />
      <EditorReference Include="$(TargetPath)" />
    </ItemGroup>

    <Csc Sources="@(EditorCompile)" TargetType="Library" OutputAssembly="$(EditorOutputPath)" References="@(EditorReference)" DefineConstants="$(DefineConstants)" DisabledWarnings="$(NoWarn)" Nullable="$(Nullable)" LangVersion="$(LangVersion)" DebugType="$(DebugType)" Optimize="$(Optimize)" Deterministic="$(Deterministic)" EmitDebugInformation="true" GenerateFullPaths="true" NoConfig="true" UseSharedCompilation="true" />
  </Target>

</Project>
